rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
  function admin() { return signed() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.get('role','user') == 'admin' && get(userPath(request.auth.uid)).data.get('disabled',false) == false; }
  function enabled() { return signed() && exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.get('disabled',false) == false; }
  function keyPath(id) { return /databases/$(database)/documents/accessKeys/$(id); }
  function receiptPath(id) { return /databases/$(database)/documents/keyRedemptions/$(id); }
  function receiptId(keyId) { return keyId + '_' + request.auth.uid; }
  function legacyRenewal(keyId) {
   let k = get(keyPath(keyId)).data;
   let u = get(userPath(request.auth.uid)).data;
   return k.get('legacy',false) == true && k.maxActivations == null
    && exists(receiptPath(receiptId(keyId)))
    && (u.get('subscription','inativa') != 'ativa' || (!u.get('subscriptionLifetime',false) && u.get('subscriptionEnd',null) is timestamp && u.subscriptionEnd <= request.time));
  }
  function validReceipt(d) {
   let k = get(keyPath(d.keyId)).data;
   let nextKey = getAfter(keyPath(d.keyId)).data;
   let u = get(userPath(request.auth.uid)).data;
   let life = k.lifetime || (u.get('subscriptionLifetime',false) && u.get('subscription','inativa') == 'ativa');
   return enabled() && d.keys().hasOnly(['uid','keyId','createdAt','lifetime','endAt'])
    && d.uid == request.auth.uid && d.keyId.matches('^[a-f0-9]{64}$')
    && d.createdAt == request.time && k.active == true
    && k.activationCount is int && k.activationCount >= 0
    && (k.maxActivations == null || k.activationCount < k.maxActivations)
    && nextKey.activationCount == k.activationCount + 1
    && d.lifetime == life
    && ((life && d.endAt == null) || (!life && k.durationDays is int && k.durationDays >= 1 && k.durationDays <= 36500 && d.endAt is timestamp
     && d.endAt >= request.time + duration.value(k.durationDays,'d') - duration.value(5,'m')
     && d.endAt <= request.time + duration.value(k.durationDays,'d') + duration.value(5,'m')));
  }
  function subscriptionGrant(uid) {
   let d = request.resource.data;
   let r = getAfter(receiptPath(d.accessRedemption)).data;
   return enabled() && uid == request.auth.uid
    && d.diff(resource.data).affectedKeys().hasOnly(['subscription','subscriptionStart','subscriptionEnd','subscriptionLifetime','accessRedemption'])
    && (!exists(receiptPath(d.accessRedemption)) || legacyRenewal(r.keyId))
    && d.accessRedemption == receiptId(r.keyId) && validReceipt(r)
    && d.subscription == 'ativa' && d.subscriptionStart == request.time
    && d.subscriptionEnd == r.endAt && d.subscriptionLifetime == r.lifetime;
  }
  match /users/{uid} {
   allow get: if signed() && (request.auth.uid == uid || admin());
   allow list: if admin();
   allow create: if admin() || (signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['firstName','lastName','name','email','numero','createdAt','customID','subscription','role','favorites'])
    && request.resource.data.get('role','user') == 'user'
    && request.resource.data.get('subscription','inativa') in ['inativa','normal','false']
    && request.resource.data.email == request.auth.token.email);
   allow update: if admin() || (enabled() && uid == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','name','numero','favorites'])) || subscriptionGrant(uid);
   allow delete: if admin();
  }
  function privateOwner(uid) { return enabled() && uid == request.auth.uid; }
  match /users/{uid}/playlists/{id} {
   allow read, delete: if privateOwner(uid);
   allow create, update: if privateOwner(uid)
    && request.resource.data.keys().hasOnly(['name','trackIds','createdAt','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
    && request.resource.data.trackIds is list && request.resource.data.trackIds.size() <= 500
    && request.resource.data.trackIds.toSet().size() == request.resource.data.trackIds.size()
    && request.resource.data.createdAt is number && request.resource.data.createdAt > 0
    && request.resource.data.updatedAt == request.time
    && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
  }
  match /users/{uid}/musicSettings/{id} {
   allow read, delete: if privateOwner(uid);
   allow create, update: if privateOwner(uid) && id == 'main'
    && request.resource.data.keys().hasOnly(['following','seen','syncHistory','updatedAt'])
    && request.resource.data.following is list && request.resource.data.following.size() <= 100
    && request.resource.data.seen is map && request.resource.data.seen.size() <= 100
    && request.resource.data.syncHistory is bool && request.resource.data.updatedAt == request.time;
  }
  match /users/{uid}/history/{id} {
   allow read, delete: if privateOwner(uid);
   allow create, update: if privateOwner(uid)
    && request.resource.data.keys().hasOnly(['key','track','positionSeconds','durationSeconds','completed','lastPlayedAt','updatedAt'])
    && request.resource.data.key is string && request.resource.data.key.size() <= 1500
    && request.resource.data.track is map
    && request.resource.data.positionSeconds is number && request.resource.data.positionSeconds >= 0
    && request.resource.data.durationSeconds is number && request.resource.data.durationSeconds >= 0
    && request.resource.data.completed is bool && request.resource.data.lastPlayedAt is number
    && request.resource.data.updatedAt == request.time;
  }
  // Adicional do equalizador: código, recibo e liberação são atômicos.
  function eqKeyPath(id) { return /databases/$(database)/documents/equalizerKeys/$(id); }
  function eqReceiptPath(id) { return /databases/$(database)/documents/equalizerRedemptions/$(id); }
  function eqGrantPath(uid) { return /databases/$(database)/documents/users/$(uid)/addons/equalizer; }
  function paidAccount() {
   let u = get(userPath(request.auth.uid)).data;
   return enabled() && u.get('subscription','inativa') == 'ativa'
    && (u.get('subscriptionLifetime',false) == true || (u.get('subscriptionEnd',null) is timestamp && u.subscriptionEnd > request.time));
  }
  function validEqReceipt(d) {
   let k = get(eqKeyPath(d.keyId)).data;
   let nextKey = getAfter(eqKeyPath(d.keyId)).data;
   let g = exists(eqGrantPath(request.auth.uid)) ? get(eqGrantPath(request.auth.uid)).data : {};
   let current = g.get('active',false) == true && (g.get('lifetime',false) == true || (g.get('endAt',null) is timestamp && g.endAt > request.time));
   let life = k.lifetime || (current && g.get('lifetime',false));
   let base = current && !g.get('lifetime',false) ? g.endAt : request.time;
   return paidAccount() && d.keys().hasOnly(['uid','keyId','feature','createdAt','lifetime','endAt'])
    && d.uid == request.auth.uid && d.keyId.matches('^[a-f0-9]{64}$')
    && d.feature == 'equalizer' && d.createdAt == request.time
    && k.feature == 'equalizer' && k.active == true
    && k.activationCount is int && k.activationCount >= 0
    && (k.maxActivations == null || k.activationCount < k.maxActivations)
    && nextKey.activationCount == k.activationCount + 1 && d.lifetime == life
    && ((life && d.endAt == null) || (!life && k.durationDays is int && k.durationDays >= 1 && k.durationDays <= 36500
     && d.endAt is timestamp && d.endAt >= base + duration.value(k.durationDays,'d') - duration.value(5,'m')
     && d.endAt <= base + duration.value(k.durationDays,'d') + duration.value(5,'m')));
  }
  function validEqGrant(uid) {
   let d = request.resource.data;
   let r = getAfter(eqReceiptPath(d.receiptId)).data;
   return uid == request.auth.uid && paidAccount()
    && d.keys().hasOnly(['feature','active','lifetime','endAt','grantedAt','keyId','receiptId'])
    && d.feature == 'equalizer' && d.active == true && d.grantedAt == request.time
    && d.receiptId == receiptId(d.keyId) && !exists(eqReceiptPath(d.receiptId))
    && validEqReceipt(r) && r.keyId == d.keyId && r.lifetime == d.lifetime && r.endAt == d.endAt;
  }
  match /users/{uid}/addons/{id} {
   allow read: if signed() && (request.auth.uid == uid || admin());
   allow create, update: if admin() || (id == 'equalizer' && validEqGrant(uid));
   allow delete: if admin();
  }
  match /equalizerKeys/{id} {
   allow get: if enabled();
   allow list, create, delete: if admin();
   allow update: if admin() || (paidAccount()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activationCount'])
    && request.resource.data.activationCount == resource.data.activationCount + 1
    && !exists(eqReceiptPath(receiptId(id)))
    && validEqReceipt(getAfter(eqReceiptPath(receiptId(id))).data)
    && getAfter(eqGrantPath(request.auth.uid)).data.receiptId == receiptId(id));
  }
  match /equalizerRedemptions/{id} {
   allow get: if admin() || (enabled() && id.matches('^[a-f0-9]{64}_' + request.auth.uid + '$'));
   allow list: if admin();
   allow create: if paidAccount() && id == receiptId(request.resource.data.keyId)
    && validEqReceipt(request.resource.data)
    && getAfter(eqGrantPath(request.auth.uid)).data.receiptId == id;
   allow update, delete: if admin();
  }
  // Presença aproximada por instalação de navegador. Sem IP ou localização.
  match /users/{uid}/devices/{id} {
   allow read: if signed() && (request.auth.uid == uid || admin());
   allow create, update: if enabled() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['uid','deviceId','browser','os','kind','installed','createdAt','lastSeen','lastLoginAt','loggedOut'])
    && request.resource.data.uid == uid && request.resource.data.deviceId == id
    && id.matches('^[a-f0-9-]{36}$')
    && request.resource.data.browser is string && request.resource.data.browser.size() <= 60
    && request.resource.data.os is string && request.resource.data.os.size() <= 60
    && request.resource.data.kind in ['Celular','Tablet','Computador']
    && request.resource.data.installed is bool && request.resource.data.loggedOut is bool
    && request.resource.data.lastSeen == request.time && request.resource.data.lastLoginAt is timestamp
    && (resource == null ? request.resource.data.createdAt == request.time && request.resource.data.lastLoginAt == request.time
     : request.resource.data.createdAt == resource.data.createdAt
      && (request.resource.data.lastLoginAt == resource.data.lastLoginAt || request.resource.data.lastLoginAt == request.time));
   allow delete: if admin();
  }
  match /{path=**}/devices/{id} { allow read: if admin(); }
  match /adminDeviceAlerts/{id} { allow read, write: if admin(); }
  match /accessKeys/{id} {
   allow get: if enabled();
   allow list, create, delete: if admin();
   allow update: if admin() || (enabled()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activationCount'])
    && request.resource.data.activationCount == resource.data.activationCount + 1
    && (!exists(receiptPath(receiptId(id))) || legacyRenewal(id))
    && validReceipt(getAfter(receiptPath(receiptId(id))).data)
    && getAfter(userPath(request.auth.uid)).data.accessRedemption == receiptId(id));
  }
  match /keyRedemptions/{id} {
   allow get: if admin() || (enabled() && id.matches('^[a-f0-9]{64}_' + request.auth.uid + '$'));
   allow list: if admin();
   allow create: if enabled() && id == receiptId(request.resource.data.keyId)
    && validReceipt(request.resource.data)
    && getAfter(userPath(request.auth.uid)).data.accessRedemption == id;
   allow update: if admin() || (enabled() && id == receiptId(request.resource.data.keyId)
    && legacyRenewal(request.resource.data.keyId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt','endAt','lifetime'])
    && validReceipt(request.resource.data)
    && getAfter(userPath(request.auth.uid)).data.accessRedemption == id);
   allow delete: if admin();
  }
  match /Chaves/{id} { allow read, write: if admin(); }
  function countersOnly() {
   let changes = request.resource.data.diff(resource.data).affectedKeys();
   return enabled() && changes.hasOnly(['playCount','downloadCount'])
    && request.resource.data.get('playCount',0) is int && request.resource.data.get('downloadCount',0) is int
    && request.resource.data.get('playCount',0) >= resource.data.get('playCount',0)
    && request.resource.data.get('playCount',0) <= resource.data.get('playCount',0)+1
    && request.resource.data.get('downloadCount',0) >= resource.data.get('downloadCount',0)
    && request.resource.data.get('downloadCount',0) <= resource.data.get('downloadCount',0)+1;
  }
  match /musicas/{id} { allow read: if true; allow create,delete: if admin(); allow update: if admin() || countersOnly(); }
  match /musicasV2/{id} { allow read: if true; allow create,delete: if admin(); allow update: if admin() || countersOnly(); }
  match /cantores/{id} { allow read: if true; allow create,delete: if admin(); allow update: if admin() || (enabled() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) && request.resource.data.downloads == resource.data.get('downloads',0)+1); }
  match /estilos/{id} { allow read: if true; allow write: if admin(); }
  match /cantoresV2/{id} { allow read: if true; allow create,delete: if admin(); allow update: if admin() || (enabled() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) && request.resource.data.downloads == resource.data.get('downloads',0)+1); }
  match /estilosV2/{id} { allow read: if true; allow write: if admin(); }
  match /{document=**} { allow read,write: if false; }
 }
}
