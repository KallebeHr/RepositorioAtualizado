rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function admin() { return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled',false) == false; }
  function owner(uid) { return signed() && request.auth.uid == uid; }
  match /users/{uid} {
   allow get: if owner(uid) || admin();
   allow list: if admin();
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['firstName','lastName','numero','email','role','subscription','favorites','createdAt']) && request.resource.data.role == 'user' && request.resource.data.subscription == 'inativa' && request.resource.data.email == request.auth.token.email && request.resource.data.favorites is list && request.resource.data.favorites.size() == 0 && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 80 && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 100;
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','numero','favorites']) && request.resource.data.get('firstName','') is string && request.resource.data.get('firstName','').size() <= 80 && request.resource.data.get('lastName','') is string && request.resource.data.get('lastName','').size() <= 100 && request.resource.data.get('numero','') is string && request.resource.data.get('numero','').size() <= 25 && request.resource.data.get('favorites',[]) is list && request.resource.data.get('favorites',[]).size() <= 5000;
   allow delete: if false;
  }
  match /musicas/{id} { allow read: if true; allow write: if false; }
  match /cantores/{id} { allow read: if true; allow write: if admin(); }
  match /estilos/{id} { allow read: if true; allow write: if admin(); }
  match /playlists/{id} {
   allow read, delete: if owner(resource.data.uid);
   allow create: if owner(request.resource.data.uid) && request.resource.data.keys().hasOnly(['uid','name','trackIds','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.trackIds is list && request.resource.data.trackIds.size() <= 2000;
   allow update: if owner(resource.data.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','trackIds']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80 && request.resource.data.trackIds is list && request.resource.data.trackIds.size() <= 2000;
  }
  match /downloads/{id} { allow read: if owner(resource.data.uid) || admin(); allow write: if false; }
  match /notifications/{id} { allow read: if signed(); allow write: if false; }
  match /{collection}/{id} { allow read: if admin() && collection in ['audit','accesses','activationKeys','packages','backups']; allow write: if false; }
 }
}
