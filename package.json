{
  "name": "repertoriozezao",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "packages:worker": "node --env-file-if-exists=.env.server scripts/package-worker.js",
    "backup": "node --env-file-if-exists=.env.server scripts/backup.js",
    "cleanup:passwords": "node --env-file-if-exists=.env.server scripts/cleanup-passwords.js",
    "migrate:r2": "node --env-file-if-exists=.env.server scripts/migrate-r2.js",
    "dev:api": "node --env-file-if-exists=.env.server scripts/dev-api.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-repertorio \"node --test tests/firestore.rules.test.mjs\"",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-repertorio \"node --test tests/firestore.rules.test.mjs tests/api.integration.test.mjs\"",
    "test:browser": "firebase emulators:exec --only firestore,auth --project demo-repertorio \"playwright test\"",
    "metadata:enrich": "node --env-file-if-exists=.env.server scripts/enrich-metadata.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fontsource/roboto": "5.2.6",
    "@heroicons/vue": "^2.2.0",
    "@mdi/font": "7.4.47",
    "@vercel/analytics": "^1.6.1",
    "archiver": "^8.0.0",
    "audiomotion-analyzer": "^4.5.4",
    "axios": "^1.11.0",
    "firebase": "^12.1.0",
    "firebase-admin": "^14.5.0",
    "howler": "^2.2.4",
    "html2pdf.js": "^0.12.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "swapy": "^1.0.5",
    "swiper": "^12.0.3",
    "vue": "^3.5.17",
    "vue-material-design-icons": "^5.3.1",
    "vue-toast-notification": "^3.1.3",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.9.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.30.1",
    "eslint-config-vuetify": "^4.0.0",
    "firebase-tools": "^13.35.1",
    "sass-embedded": "^1.89.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-fonts": "^1.3.1",
    "unplugin-vue-components": "^28.8.0",
    "unplugin-vue-router": "^0.14.0",
    "vite": "^6.3.5",
    "vite-plugin-vue-layouts-next": "^1.0.0",
    "vite-plugin-vuetify": "^2.1.1",
    "vue-router": "^4.5.1"
  },
  "engines": {
    "node": "24.x"
  }
}
